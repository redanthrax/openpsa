@using Contracts.Sites
@using Contracts.Clients
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>@(Site is not null ? "Edit Site" : "New Site")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            @if (Site is null) {
                <MudAutocomplete T="ClientSummaryDto" Label="Client" Required="true"
                    @bind-Value="_client" SearchFunc="SearchClientsAsync"
                    ToStringFunc="@(c => c?.Name ?? string.Empty)"
                    Variant="Variant.Outlined" Class="mb-3" />
            }
            <MudTextField @bind-Value="_name" Label="Site Name" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_address" Label="Address"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="5">
                    <MudTextField @bind-Value="_city" Label="City" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="_state" Label="State" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField @bind-Value="_postalCode" Label="Postal Code" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="6">
                    <MudTextField @bind-Value="_country" Label="Country" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_timezone" Label="Timezone" Variant="Variant.Outlined"
                        HelperText="e.g. America/New_York" />
                </MudItem>
            </MudGrid>
            <MudTextField @bind-Value="_phone" Label="Phone"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_notes" Label="Notes" Lines="2"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudSwitch @bind-Value="_isPrimary" Label="Primary Site" Color="Color.Primary" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || !_valid">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SiteSummaryDto? Site { get; set; }

    private ClientSummaryDto? _client;
    private List<ClientSummaryDto> _allClients = [];
    private string _name = string.Empty;
    private string? _address, _city, _state, _postalCode, _country, _timezone, _phone, _notes;
    private bool _isPrimary;
    private MudForm _form = null!;
    private bool _valid, _saving;

    protected override async Task OnInitializedAsync() {
        var cr = await Api.GetAsync<List<ClientSummaryDto>>("/api/clients");
        if (cr.Success && cr.Data is not null) _allClients = cr.Data;

        if (Site is not null) {
            var r = await Api.GetAsync<SiteDto>($"/api/sites/{Site.Id}");
            if (r.Success && r.Data is not null) {
                var s = r.Data;
                _name = s.Name;
                _address = s.Address;
                _city = s.City;
                _state = s.State;
                _postalCode = s.PostalCode;
                _country = s.Country;
                _timezone = s.Timezone;
                _phone = s.Phone;
                _notes = s.Notes;
                _isPrimary = s.IsPrimary;
            }
        }
    }

    private Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? val, CancellationToken ct) {
        var res = string.IsNullOrWhiteSpace(val) ? _allClients
            : _allClients.Where(c => c.Name.Contains(val, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ClientSummaryDto>>(res);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid) return;
        _saving = true;

        if (Site is not null) {
            var update = new UpdateSiteRequest {
                Name = _name, Address = _address, City = _city, State = _state,
                PostalCode = _postalCode, Country = _country, Timezone = _timezone,
                Phone = _phone, Notes = _notes, IsPrimary = _isPrimary
            };
            var r = await Api.PutAsync<SiteDto>($"/api/sites/{Site.Id}", update);
            if (r.Success) { Snackbar.Add("Site updated.", Severity.Success); MudDialog.Close(); }
        } else {
            if (_client is null) { _saving = false; return; }
            var create = new CreateSiteRequest {
                ClientId = _client.Id, Name = _name, Address = _address, City = _city, State = _state,
                PostalCode = _postalCode, Country = _country, Timezone = _timezone,
                Phone = _phone, Notes = _notes, IsPrimary = _isPrimary
            };
            var r = await Api.PostAsync<SiteDto>("/api/sites", create);
            if (r.Success) { Snackbar.Add("Site created.", Severity.Success); MudDialog.Close(); }
        }
        _saving = false;
    }
}

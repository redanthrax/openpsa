@page "/settings/roles"
@layout SettingsLayout
@inject IApiClient Api
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Roles — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Roles</MudText>
    <HasPermission Permission="roles.create">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="@(() => Nav.NavigateTo("/settings/roles/new"))">New Role</MudButton>
    </HasPermission>
</div>

<MudGrid>
    @foreach (var role in _roles) {
        <MudItem xs="12" sm="6" md="4">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@role.Name</MudText>
                        @if (!string.IsNullOrEmpty(role.Description)) {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@role.Description</MudText>
                        }
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <HasPermission Permission="roles.update">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                OnClick="@(() => OpenEditDialog(role))" />
                        </HasPermission>
                        <HasPermission Permission="roles.delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                OnClick="@(() => DeleteAsync(role.Id, role.Name))" />
                        </HasPermission>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@role.Permissions.Count permissions</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (_loading) {
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@code {
    private List<Contracts.Roles.RoleDto> _roles = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetAsync<List<Contracts.Roles.RoleDto>>("/api/roles");
        if (result.Success && result.Data is not null) _roles = result.Data;
        _loading = false;
    }


    private async Task OpenEditDialog(Contracts.Roles.RoleDto role) {
        var param = new DialogParameters<RoleDialog> { { x => x.Role, role } };
        var dialog = await Dialog.ShowAsync<RoleDialog>("Edit Role", param);
        if (!(await dialog.Result).Canceled) await LoadAsync();
    }

    private async Task DeleteAsync(Guid id, string name) {
        var ok = await Dialog.ShowMessageBox("Delete Role",
            $"Delete role \"{name}\"? Users assigned this role will lose its permissions.", "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var result = await Api.DeleteAsync<object>($"/api/roles/{id}");
        if (result.Success) { Snackbar.Add("Role deleted.", Severity.Success); await LoadAsync(); }
    }
}

@page "/settings/email"
@layout SettingsLayout
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Mailbox Connections — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Mailbox Connections</MudText>
</div>

<DataGridPage T="Contracts.Email.MailboxConnectionSummaryDto" Items="_connections" Loading="_loading"
    SearchFunc="@((Func<Contracts.Email.MailboxConnectionSummaryDto, string>)(x => $"{x.Name} {x.EmailAddress} {x.Provider} {x.Status}"))">
    <ToolbarContent>
        <HasPermission Permission="mailbox-connections.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/settings/email/new"))">
                New Connection
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Email.MailboxConnectionSummaryDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <PropertyColumn T="Contracts.Email.MailboxConnectionSummaryDto" TProperty="string" Property="x => x.EmailAddress" Title="Email" />
        <PropertyColumn T="Contracts.Email.MailboxConnectionSummaryDto" TProperty="Contracts.Email.MailboxProvider" Property="x => x.Provider" Title="Provider">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@ProviderColor(context.Item.Provider)">
                    @FormatProvider(context.Item.Provider)
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Email.MailboxConnectionSummaryDto" TProperty="Contracts.Email.MailboxConnectionStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Email.MailboxConnectionSummaryDto" TProperty="int" Property="x => x.MessageCount" Title="Messages" />
        <PropertyColumn T="Contracts.Email.MailboxConnectionSummaryDto" TProperty="DateTime?" Property="x => x.LastPollAt" Title="Last Poll" Format="MMM d, HH:mm" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Email.MailboxConnectionSummaryDto> _connections = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Email.MailboxConnectionSummaryDto>("/api/mailbox-connections?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _connections = result.Data.ToList();
        _loading = false;
    }


    private static Color ProviderColor(Contracts.Email.MailboxProvider p) => p switch {
        Contracts.Email.MailboxProvider.MicrosoftGraph => Color.Info,
        Contracts.Email.MailboxProvider.Imap => Color.Primary,
        _ => Color.Default
    };

    private static string FormatProvider(Contracts.Email.MailboxProvider p) => p switch {
        Contracts.Email.MailboxProvider.MicrosoftGraph => "Microsoft 365",
        Contracts.Email.MailboxProvider.Imap => "IMAP/SMTP",
        _ => p.ToString()
    };

    private static Color StatusColor(Contracts.Email.MailboxConnectionStatus s) => s switch {
        Contracts.Email.MailboxConnectionStatus.Active => Color.Success,
        Contracts.Email.MailboxConnectionStatus.Error => Color.Error,
        _ => Color.Default
    };
}

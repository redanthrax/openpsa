@page "/clients/{Id:guid}/sites"
@layout Layout.ClientLayout
@using Contracts.Sites
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Sites — OpenPsa</PageTitle>

@if (_loading) {
    <MudProgressLinear Indeterminate="true" />
} else {
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Sites</MudText>
        <HasPermission Permission="sites.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="@(() => Nav.NavigateTo($"/clients/{Id}/sites/new"))">
                New Site
            </MudButton>
        </HasPermission>
    </div>

    <MudTable Items="_sites" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>City</MudTh>
            <MudTh>State</MudTh>
            <MudTh>Timezone</MudTh>
            <MudTh>Primary</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.City</MudTd>
            <MudTd>@context.State</MudTd>
            <MudTd>@context.Timezone</MudTd>
            <MudTd>
                @if (context.IsPrimary) {
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary">No sites.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private List<SiteSummaryDto> _sites = [];
    private bool _loading = true;

    protected override async Task OnParametersSetAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<SiteSummaryDto>($"/api/sites?clientId={Id}&pageSize=100");
        if (result.Success && result.Data is not null) _sites = result.Data.ToList();
        _loading = false;
    }
}

@page "/tickets"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Tickets — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Tickets</MudText>
</div>

<DataGridPage T="Contracts.Tickets.TicketSummaryDto" Items="_tickets" Loading="_loading"
    SearchFunc="@((Func<Contracts.Tickets.TicketSummaryDto, string>)(x => $"{x.Title} {x.ClientName} {x.Status} {x.Priority}"))"
    RowClick="@(args => Nav.NavigateTo($"/tickets/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="tickets.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/tickets/new"))">
                New Ticket
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Tickets.TicketSummaryDto" TProperty="string" Property="x => x.Title" Title="Title" />
        <PropertyColumn T="Contracts.Tickets.TicketSummaryDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Tickets.TicketSummaryDto" TProperty="Contracts.Tickets.TicketStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Tickets.TicketSummaryDto" TProperty="Contracts.Tickets.TicketPriority" Property="x => x.Priority" Title="Priority">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@PriorityColor(context.Item.Priority)">
                    @context.Item.Priority
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Tickets.TicketSummaryDto" TProperty="string" Property="x => x.AssignedToUserName" Title="Assigned To" />
        <TemplateColumn T="Contracts.Tickets.TicketSummaryDto" Title="Due" SortBy="x => x.DueDate">
            <CellTemplate>
                @if (context.Item.DueDate.HasValue) {
                    var overdue = context.Item.DueDate < DateTime.UtcNow &&
                        context.Item.Status != Contracts.Tickets.TicketStatus.Resolved &&
                        context.Item.Status != Contracts.Tickets.TicketStatus.Closed;
                    <MudText Color="@(overdue ? Color.Error : Color.Default)">
                        @context.Item.DueDate.Value.ToString("MMM d")
                    </MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Tickets.TicketSummaryDto> _tickets = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Tickets.TicketSummaryDto>("/api/tickets?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _tickets = result.Data.ToList();
        _loading = false;
    }


    private static Color StatusColor(Contracts.Tickets.TicketStatus s) => s switch {
        Contracts.Tickets.TicketStatus.New => Color.Default,
        Contracts.Tickets.TicketStatus.Open or Contracts.Tickets.TicketStatus.InProgress => Color.Info,
        Contracts.Tickets.TicketStatus.PendingCustomer => Color.Warning,
        Contracts.Tickets.TicketStatus.Resolved or Contracts.Tickets.TicketStatus.Closed => Color.Success,
        _ => Color.Default
    };

    private static Color PriorityColor(Contracts.Tickets.TicketPriority p) => p switch {
        Contracts.Tickets.TicketPriority.Critical => Color.Error,
        Contracts.Tickets.TicketPriority.High => Color.Warning,
        Contracts.Tickets.TicketPriority.Medium => Color.Info,
        _ => Color.Default
    };
}

@page "/agreements"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Agreements — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Agreements</MudText>
</div>

<DataGridPage T="Contracts.Agreements.AgreementSummaryDto" Items="_agreements" Loading="_loading"
    SearchFunc="@((Func<Contracts.Agreements.AgreementSummaryDto, string>)(x => $"{x.Name} {x.ClientName} {x.Status} {x.Type}"))"
    RowClick="@(args => Nav.NavigateTo($"/agreements/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="agreements.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/agreements/new"))">
                New Agreement
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Agreements.AgreementSummaryDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <PropertyColumn T="Contracts.Agreements.AgreementSummaryDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Agreements.AgreementSummaryDto" TProperty="Contracts.Agreements.AgreementType" Property="x => x.Type" Title="Type">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@TypeColor(context.Item.Type)">
                    @FormatType(context.Item.Type)
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Agreements.AgreementSummaryDto" TProperty="Contracts.Agreements.AgreementStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Agreements.AgreementSummaryDto" TProperty="DateTime" Property="x => x.StartDate" Title="Start" Format="MMM d, yyyy" />
        <PropertyColumn T="Contracts.Agreements.AgreementSummaryDto" TProperty="DateTime?" Property="x => x.EndDate" Title="End" Format="MMM d, yyyy" />
        <TemplateColumn T="Contracts.Agreements.AgreementSummaryDto" Title="Monthly" SortBy="x => x.MonthlyAmount">
            <CellTemplate>
                @if (context.Item.MonthlyAmount.HasValue) {
                    <MudText>@context.Item.MonthlyAmount.Value.ToString("C2")</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Contracts.Agreements.AgreementSummaryDto" Title="Block Hours" SortBy="x => x.BlockHoursRemaining">
            <CellTemplate>
                @if (context.Item.BlockHoursRemaining.HasValue) {
                    <MudText Color="@(context.Item.BlockHoursRemaining <= 0 ? Color.Error : Color.Default)">
                        @context.Item.BlockHoursRemaining.Value.ToString("N1") hrs
                    </MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Agreements.AgreementSummaryDto> _agreements = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Agreements.AgreementSummaryDto>("/api/agreements?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _agreements = result.Data.ToList();
        _loading = false;
    }


    private static Color StatusColor(Contracts.Agreements.AgreementStatus s) => s switch {
        Contracts.Agreements.AgreementStatus.Active => Color.Success,
        Contracts.Agreements.AgreementStatus.Draft => Color.Default,
        Contracts.Agreements.AgreementStatus.Expiring => Color.Warning,
        Contracts.Agreements.AgreementStatus.Expired => Color.Error,
        Contracts.Agreements.AgreementStatus.Cancelled => Color.Dark,
        _ => Color.Default
    };

    private static Color TypeColor(Contracts.Agreements.AgreementType t) => t switch {
        Contracts.Agreements.AgreementType.Retainer => Color.Primary,
        Contracts.Agreements.AgreementType.BlockHours => Color.Info,
        Contracts.Agreements.AgreementType.FixedFee => Color.Secondary,
        _ => Color.Default
    };

    private static string FormatType(Contracts.Agreements.AgreementType t) => t switch {
        Contracts.Agreements.AgreementType.TimeAndMaterials => "T&M",
        Contracts.Agreements.AgreementType.FixedFee => "Fixed Fee",
        Contracts.Agreements.AgreementType.BlockHours => "Block Hours",
        _ => t.ToString()
    };
}

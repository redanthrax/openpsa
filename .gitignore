# Verify (snapshot testing)
*.received.*
*.received/

# ──────────────────────────────────────────────
# Secrets — DO NOT COMMIT
# ──────────────────────────────────────────────
**/secrets.json
# Per-environment overrides — must NOT be committed. Use `dotnet user-secrets`
# (development) or environment variables / Key Vault (production) instead.
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Staging.json
**/appsettings.Local.json
**/appsettings.*.local.json
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
*.kubeconfig
kubeconfig*
azure.auth
*.publishsettings
*.azurePubxml

# ──────────────────────────────────────────────
# Infrastructure / deployment local state
# ──────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.tye/
deploy/**/values.local.yaml
deploy/**/*.local.yaml
deploy/**/*.local.yml

# ──────────────────────────────────────────────
# Logs / runtime data
# ──────────────────────────────────────────────
logs/
*.log
serilog*.json
.keys/

# ──────────────────────────────────────────────
# Docker volumes
# ──────────────────────────────────────────────
postgres-data/
postgres_data/
redis-data/
redis_data/

# ──────────────────────────────────────────────
# Entity Framework local scratch
# ──────────────────────────────────────────────
*.mdf
*.ldf

# ──────────────────────────────────────────────

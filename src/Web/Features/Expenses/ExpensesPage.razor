@page "/expenses"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Expenses — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Expenses</MudText>
</div>

<DataGridPage T="Contracts.Expenses.ExpenseSummaryDto" Items="_expenses" Loading="_loading"
    SearchFunc="@((Func<Contracts.Expenses.ExpenseSummaryDto, string>)(x => $"{x.Description} {x.ClientName} {x.Category} {x.Status}"))"
    RowClick="@(args => Nav.NavigateTo($"/expenses/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="expenses.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/expenses/new"))">
                New Expense
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="string" Property="x => x.Description" Title="Description" />
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="Contracts.Expenses.ExpenseCategory" Property="x => x.Category" Title="Category">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@CategoryColor(context.Item.Category)">
                    @context.Item.Category
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="Contracts.Expenses.ExpenseStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="Contracts.Expenses.ExpenseSummaryDto" Title="Amount" SortBy="x => x.Amount">
            <CellTemplate><MudText>@context.Item.Amount.ToString("C2")</MudText></CellTemplate>
        </TemplateColumn>
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="DateTime" Property="x => x.ExpenseDate" Title="Date" Format="MMM d, yyyy" />
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="bool" Property="x => x.Billable" Title="Billable">
            <CellTemplate>
                @if (context.Item.Billable) {
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Color="Color.Success" />
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Expenses.ExpenseSummaryDto" TProperty="string" Property="x => x.UserName" Title="User" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Expenses.ExpenseSummaryDto> _expenses = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Expenses.ExpenseSummaryDto>("/api/expenses?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _expenses = result.Data.ToList();
        _loading = false;
    }


    private static Color CategoryColor(Contracts.Expenses.ExpenseCategory c) => c switch {
        Contracts.Expenses.ExpenseCategory.Travel => Color.Info,
        Contracts.Expenses.ExpenseCategory.Hardware => Color.Primary,
        Contracts.Expenses.ExpenseCategory.Software or Contracts.Expenses.ExpenseCategory.Licensing => Color.Warning,
        Contracts.Expenses.ExpenseCategory.Subcontractor => Color.Error,
        _ => Color.Default
    };

    private static Color StatusColor(Contracts.Expenses.ExpenseStatus s) => s switch {
        Contracts.Expenses.ExpenseStatus.Approved => Color.Success,
        Contracts.Expenses.ExpenseStatus.Submitted => Color.Info,
        Contracts.Expenses.ExpenseStatus.Rejected => Color.Error,
        Contracts.Expenses.ExpenseStatus.Invoiced => Color.Primary,
        _ => Color.Default
    };
}

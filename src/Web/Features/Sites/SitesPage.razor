@page "/sites"
@inject IApiClient Api
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>Sites — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Sites</MudText>
    <HasPermission Permission="sites.create">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="OpenCreateDialog">New Site</MudButton>
    </HasPermission>
</div>

<MudCard>
    <MudCardContent Class="pa-0">
        <MudDataGrid T="Contracts.Sites.SiteSummaryDto" Items="_sites" Loading="_loading"
            Filterable="true" FilterMode="DataGridFilterMode.Simple" SortMode="SortMode.Multiple"
            Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.ClientName" Title="Client" />
                <PropertyColumn Property="x => x.City" Title="City" />
                <PropertyColumn Property="x => x.State" Title="State" />
                <PropertyColumn Property="x => x.Timezone" Title="Timezone" />
                <PropertyColumn Property="x => x.IsPrimary" Title="Primary">
                    <CellTemplate>
                        @if (context.Item.IsPrimary) {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Primary</MudChip>
                        }
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <HasPermission Permission="sites.update">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                OnClick="@(() => OpenEditDialog(context.Item))" />
                        </HasPermission>
                        <HasPermission Permission="sites.delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                OnClick="@(() => DeleteAsync(context.Item.Id, context.Item.Name))" />
                        </HasPermission>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private List<Contracts.Sites.SiteSummaryDto> _sites = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetAsync<List<Contracts.Sites.SiteSummaryDto>>("/api/sites");
        if (result.Success && result.Data is not null) _sites = result.Data;
        _loading = false;
    }

    private async Task OpenCreateDialog() {
        var dialog = await Dialog.ShowAsync<SiteDialog>("New Site",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result).Canceled) await LoadAsync();
    }

    private async Task OpenEditDialog(Contracts.Sites.SiteSummaryDto site) {
        var param = new DialogParameters<SiteDialog> { { x => x.Site, site } };
        var dialog = await Dialog.ShowAsync<SiteDialog>("Edit Site", param,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await dialog.Result).Canceled) await LoadAsync();
    }

    private async Task DeleteAsync(Guid id, string name) {
        var ok = await Dialog.ShowMessageBox("Delete Site",
            $"Delete \"{name}\"? This cannot be undone.", "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var result = await Api.DeleteAsync<object>($"/api/sites/{id}");
        if (result.Success) { Snackbar.Add("Site deleted.", Severity.Success); await LoadAsync(); }
    }
}

@inject IUserPermissionService PermissionService
@inject NavigationManager Nav
@implements IDisposable

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Class="px-4 pt-4 pb-2" Color="Color.Secondary">OpenPsa</MudText>
    <MudDivider Class="mb-2" />

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    @if (!PermissionService.IsInitialized) {
        @for (var i = 0; i < 6; i++) {
            <div class="px-4 py-2"><MudSkeleton Width="75%" Height="22px" /></div>
        }
    } else {
        <HasPermission Permission="clients.list">
            <MudNavLink Href="/clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Business">
                Clients
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="contacts.list">
            <MudNavLink Href="/contacts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Contacts">
                Contacts
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="sites.list">
            <MudNavLink Href="/sites" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocationOn">
                Sites
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="projects.list">
            <MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderOpen">
                Projects
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="tickets.list">
            <MudNavLink Href="/tickets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ConfirmationNumber">
                Tickets
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="time-entries.list">
            <MudNavLink Href="/time-entries" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccessTime">
                Time Entries
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="invoices.list">
            <MudNavLink Href="/invoices" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                Invoicing
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="expenses.list">
            <MudNavLink Href="/expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
                Expenses
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="agreements.list">
            <MudNavLink Href="/agreements" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">
                Agreements
            </MudNavLink>
        </HasPermission>

        <HasPermission Permission="assets.list">
            <MudNavLink Href="/assets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">
                Assets
            </MudNavLink>
        </HasPermission>

        <MudDivider Class="my-2" />

        <HasPermission AnyPermissions="@(new[]{"users.list","roles.list","settings.view","audit.list","sla-policies.list","ticket-queues.list","rate-cards.list","mailbox-connections.list"})">
            <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                <HasPermission Permission="users.list">
                    <MudNavLink Href="/settings/users">Users</MudNavLink>
                </HasPermission>
                <HasPermission Permission="roles.list">
                    <MudNavLink Href="/settings/roles">Roles</MudNavLink>
                </HasPermission>
                <HasPermission Permission="settings.view">
                    <MudNavLink Href="/settings/general">General</MudNavLink>
                </HasPermission>
                <HasPermission Permission="sla-policies.list">
                    <MudNavLink Href="/sla-policies">SLA Policies</MudNavLink>
                </HasPermission>
                <HasPermission Permission="ticket-queues.list">
                    <MudNavLink Href="/ticket-queues">Ticket Queues</MudNavLink>
                </HasPermission>
                <HasPermission Permission="rate-cards.list">
                    <MudNavLink Href="/rate-cards">Rate Cards</MudNavLink>
                </HasPermission>
                <HasPermission Permission="mailbox-connections.list">
                    <MudNavLink Href="/mailbox-connections">Email Connections</MudNavLink>
                </HasPermission>
                <HasPermission Permission="audit.list">
                    <MudNavLink Href="/settings/audit">Audit Log</MudNavLink>
                </HasPermission>
            </MudNavGroup>
        </HasPermission>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() =>
        PermissionService.OnPermissionsChanged += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => PermissionService.OnPermissionsChanged -= Refresh;
}

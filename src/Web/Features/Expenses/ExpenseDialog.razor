@using Contracts.Expenses
@using Contracts.Clients
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>@(ExpenseId.HasValue ? "Edit Expense" : "New Expense")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_description" Label="Description" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="6">
                    <MudSelect @bind-Value="_category" Label="Category" Variant="Variant.Outlined">
                        @foreach (var c in Enum.GetValues<ExpenseCategory>()) {
                            <MudSelectItem Value="c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_amount" Label="Amount" Required="true"
                        Variant="Variant.Outlined" Format="N2" Min="0m"
                        Adornment="Adornment.Start" AdornmentText="$" />
                </MudItem>
            </MudGrid>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="_expenseDate" Label="Date" Required="true"
                        Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    @if (ExpenseId.HasValue) {
                        <MudSelect @bind-Value="_status" Label="Status" Variant="Variant.Outlined">
                            @foreach (var s in Enum.GetValues<ExpenseStatus>()) {
                                <MudSelectItem Value="s">@s</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
            </MudGrid>
            @if (!ExpenseId.HasValue) {
                <MudAutocomplete T="ClientSummaryDto" Label="Client"
                    @bind-Value="_client" SearchFunc="SearchClientsAsync"
                    ToStringFunc="@(c => c?.Name ?? string.Empty)"
                    Variant="Variant.Outlined" Class="mb-3" />
            }
            <MudSwitch @bind-Value="_billable" Label="Billable" Color="Color.Primary" Class="mb-3" />
            <MudTextField @bind-Value="_notes" Label="Notes" Lines="2"
                Variant="Variant.Outlined" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || !_valid">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? ExpenseId { get; set; }

    private ClientSummaryDto? _client;
    private List<ClientSummaryDto> _allClients = [];
    private string _description = string.Empty;
    private ExpenseCategory _category = ExpenseCategory.Other;
    private ExpenseStatus _status = ExpenseStatus.Draft;
    private decimal _amount;
    private DateTime? _expenseDate = DateTime.Today;
    private bool _billable = true;
    private string? _notes;
    private MudForm _form = null!;
    private bool _valid, _saving;

    protected override async Task OnInitializedAsync() {
        var cr = await Api.GetAsync<List<ClientSummaryDto>>("/api/clients");
        if (cr.Success && cr.Data is not null) _allClients = cr.Data;

        if (ExpenseId.HasValue) {
            var r = await Api.GetAsync<ExpenseDto>($"/api/expenses/{ExpenseId.Value}");
            if (r.Success && r.Data is not null) {
                var e = r.Data;
                _description = e.Description;
                _category = e.Category;
                _status = e.Status;
                _amount = e.Amount;
                _expenseDate = e.ExpenseDate;
                _billable = e.Billable;
                _notes = e.Notes;
            }
        }
    }

    private Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? val, CancellationToken ct) {
        var res = string.IsNullOrWhiteSpace(val) ? _allClients
            : _allClients.Where(c => c.Name.Contains(val, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ClientSummaryDto>>(res);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid || _expenseDate is null) return;
        _saving = true;

        if (ExpenseId.HasValue) {
            var update = new UpdateExpenseRequest {
                Description = _description, Category = _category, Status = _status,
                Amount = _amount, ExpenseDate = _expenseDate.Value, Billable = _billable, Notes = _notes
            };
            var r = await Api.PutAsync<ExpenseDto>($"/api/expenses/{ExpenseId.Value}", update);
            if (r.Success) { Snackbar.Add("Expense updated.", Severity.Success); MudDialog.Close(); }
        } else {
            var create = new CreateExpenseRequest {
                Description = _description, Category = _category,
                Amount = _amount, ExpenseDate = _expenseDate.Value, Billable = _billable,
                ClientId = _client?.Id, Notes = _notes
            };
            var r = await Api.PostAsync<ExpenseDto>("/api/expenses", create);
            if (r.Success) { Snackbar.Add("Expense created.", Severity.Success); MudDialog.Close(); }
        }
        _saving = false;
    }
}

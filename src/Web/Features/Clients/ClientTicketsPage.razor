@page "/clients/{Id:guid}/tickets"
@layout Layout.ClientLayout
@using Contracts.Tickets
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Tickets — OpenPsa</PageTitle>

@if (_loading) {
    <MudProgressLinear Indeterminate="true" />
} else {
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Tickets</MudText>
        <HasPermission Permission="tickets.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="@(() => Nav.NavigateTo($"/clients/{Id}/tickets/new"))">
                New Ticket
            </MudButton>
        </HasPermission>
    </div>

    <MudTable T="TicketDto" Items="_tickets" Dense="true" Hover="true" Elevation="1"
        OnRowClick="@(r => Nav.NavigateTo($"/tickets/{r.Item.Id}"))">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Priority</MudTh>
            <MudTh>Assigned To</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Status</MudChip></MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Priority</MudChip></MudTd>
            <MudTd>@(context.AssignedToUserName ?? "Unassigned")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary">No tickets.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private List<TicketDto> _tickets = [];
    private bool _loading = true;

    protected override async Task OnParametersSetAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<TicketDto>($"/api/tickets?clientId={Id}&pageSize=100");
        if (result.Success && result.Data is not null) _tickets = result.Data.ToList();
        _loading = false;
    }
}

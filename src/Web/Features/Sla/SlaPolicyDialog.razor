@using Contracts.Sla
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>@(PolicyId.HasValue ? "Edit SLA Policy" : "New SLA Policy")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_name" Label="Name" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_description" Label="Description" Lines="2"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudSwitch @bind-Value="_isDefault" Label="Default Policy" Color="Color.Primary" Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Targets by Priority</MudText>
            @foreach (var target in _targets) {
                <MudGrid Class="mb-2" Spacing="1">
                    <MudItem xs="4">
                        <MudSelect @bind-Value="target.Priority" Label="Priority" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var p in Enum.GetValues<SlaPriorityLevel>()) {
                                <MudSelectItem Value="p">@p</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="3">
                        <MudNumericField @bind-Value="target.ResponseTimeMinutes" Label="Response (min)"
                            Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                    </MudItem>
                    <MudItem xs="3">
                        <MudNumericField @bind-Value="target.ResolutionTimeMinutes" Label="Resolution (min)"
                            Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
                    </MudItem>
                    <MudItem xs="2" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                            Color="Color.Error" OnClick="@(() => _targets.Remove(target))" />
                    </MudItem>
                </MudGrid>
            }
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text"
                OnClick="AddTarget" Class="mt-1">Add Target</MudButton>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
            Disabled="_saving || !_valid || _targets.Count == 0">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? PolicyId { get; set; }

    private string _name = string.Empty;
    private string? _description;
    private bool _isDefault;
    private List<CreateSlaTargetRequest> _targets = [];
    private MudForm _form = null!;
    private bool _valid, _saving;

    protected override async Task OnInitializedAsync() {
        if (PolicyId.HasValue) {
            var r = await Api.GetAsync<SlaPolicyDto>($"/api/sla-policies/{PolicyId}");
            if (r.Success && r.Data is not null) {
                _name = r.Data.Name;
                _description = r.Data.Description;
                _isDefault = r.Data.IsDefault;
                _targets = r.Data.Targets.Select(t => new CreateSlaTargetRequest {
                    Priority = t.Priority,
                    ResponseTimeMinutes = t.ResponseTimeMinutes,
                    ResolutionTimeMinutes = t.ResolutionTimeMinutes
                }).ToList();
            }
        } else {
            AddTarget();
        }
    }

    private void AddTarget() => _targets.Add(new CreateSlaTargetRequest {
        Priority = SlaPriorityLevel.Medium,
        ResponseTimeMinutes = 60,
        ResolutionTimeMinutes = 480
    });

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid || _targets.Count == 0) return;
        _saving = true;

        if (PolicyId.HasValue) {
            var update = new UpdateSlaPolicyRequest {
                Name = _name, Description = _description,
                IsDefault = _isDefault, Targets = _targets
            };
            var r = await Api.PutAsync<SlaPolicyDto>($"/api/sla-policies/{PolicyId}", update);
            if (r.Success) { Snackbar.Add("SLA Policy updated.", Severity.Success); MudDialog.Close(); }
        } else {
            var create = new CreateSlaPolicyRequest {
                Name = _name, Description = _description,
                IsDefault = _isDefault, Targets = _targets
            };
            var r = await Api.PostAsync<SlaPolicyDto>("/api/sla-policies", create);
            if (r.Success) { Snackbar.Add("SLA Policy created.", Severity.Success); MudDialog.Close(); }
        }
        _saving = false;
    }
}

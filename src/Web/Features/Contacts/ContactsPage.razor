@page "/contacts"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Contacts — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Contacts</MudText>
</div>

<DataGridPage T="Contracts.Contacts.ContactDto" Items="_contacts" Loading="_loading"
    SearchFunc="@((Func<Contracts.Contacts.ContactDto, string>)(x => $"{x.FullName} {x.ClientName} {x.Email}"))"
    RowClick="@(args => Nav.NavigateTo($"/contacts/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="contacts.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/contacts/new"))">
                New Contact
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <TemplateColumn T="Contracts.Contacts.ContactDto" Title="Name" SortBy="x => x.FullName">
            <CellTemplate>
                <MudText>@context.Item.FullName</MudText>
                @if (context.Item.IsPrimary) {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-1">Primary</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn T="Contracts.Contacts.ContactDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Contacts.ContactDto" TProperty="string" Property="x => x.Title" Title="Title" />
        <PropertyColumn T="Contracts.Contacts.ContactDto" TProperty="string" Property="x => x.Email" Title="Email" />
        <PropertyColumn T="Contracts.Contacts.ContactDto" TProperty="string" Property="x => x.Phone" Title="Phone" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Contacts.ContactDto> _contacts = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Contacts.ContactDto>("/api/contacts?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _contacts = result.Data.ToList();
        _loading = false;
    }

}

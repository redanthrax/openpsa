# ──────────────────────────────────────────────
# Build outputs (case-insensitive, nested anywhere)
# ──────────────────────────────────────────────
[Bb]in/
[Oo]bj/
out/
[Oo]ut/
artifacts/
publish/
[Pp]ublish/

# Defensive: literal-backslash directories created by Windows tools on *nix
# (e.g. "bin\Debug" as a single filename). These do NOT match bin/ rules.
**/bin\\*
**/obj\\*
**/*\\Debug
**/*\\Release

# ──────────────────────────────────────────────
# IDE / editor
# ──────────────────────────────────────────────
.vs/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.fleet/
.ionide/
.history/
*.swp
*.swo
*~

# Visual Studio / Rider
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.ncrunchproject
*.ncrunchsolution
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ──────────────────────────────────────────────
# .NET binaries / debug / cache
# ──────────────────────────────────────────────
*.dll
*.exe
*.pdb
*.cache
*.log
*.tlog
*.vspscc
*.vssscc
StyleCopReport.xml
*.GhostDoc.xml


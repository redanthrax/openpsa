@page "/settings/audit"
@layout SettingsLayout
@inject IApiClient Api

<PageTitle>Audit Log — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Audit Log</MudText>
</div>

<DataGridPage T="Contracts.Audit.AuditEntryDto" Items="_entries" Loading="_loading"
    SearchFunc="@((Func<Contracts.Audit.AuditEntryDto, string>)(x => $"{x.UserName} {x.Action} {x.EntityName}"))">
    <Columns>
        <PropertyColumn T="Contracts.Audit.AuditEntryDto" TProperty="DateTime" Property="x => x.CreatedAt" Title="Time" Format="MMM d, yyyy HH:mm" />
        <PropertyColumn T="Contracts.Audit.AuditEntryDto" TProperty="string" Property="x => x.UserName" Title="User" />
        <PropertyColumn T="Contracts.Audit.AuditEntryDto" TProperty="string" Property="x => x.Action" Title="Action">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@ActionColor(context.Item.Action)">
                    @context.Item.Action
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Audit.AuditEntryDto" TProperty="string" Property="x => x.EntityName" Title="Entity" />
        <PropertyColumn T="Contracts.Audit.AuditEntryDto" TProperty="string" Property="x => x.EntityId" Title="Entity ID" />
        <PropertyColumn T="Contracts.Audit.AuditEntryDto" TProperty="string" Property="x => x.ChangedProperties" Title="Changed Fields" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Audit.AuditEntryDto> _entries = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Audit.AuditEntryDto>("/api/audit?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _entries = result.Data.ToList();
        _loading = false;
    }

    private static Color ActionColor(string action) => action switch {
        "Created" => Color.Success,
        "Updated" => Color.Info,
        "Deleted" => Color.Error,
        _ => Color.Default
    };
}

@using Contracts.Projects
@using Contracts.Clients
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>@(ProjectId.HasValue ? "Edit Project" : "New Project")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudAutocomplete T="ClientSummaryDto" Label="Client" Required="true"
                @bind-Value="_client" SearchFunc="SearchClientsAsync"
                ToStringFunc="@(c => c?.Name ?? string.Empty)"
                Variant="Variant.Outlined" Class="mb-3" Disabled="ProjectId.HasValue" />
            <MudTextField @bind-Value="_model.Description" Label="Description" Lines="2"
                Variant="Variant.Outlined" Class="mb-3" />
            @if (ProjectId.HasValue) {
                <MudSelect @bind-Value="_updateStatus" Label="Status" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var s in Enum.GetValues<ProjectStatus>()) {
                        <MudSelectItem Value="s">@s</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudDatePicker @bind-Date="_startDate" Label="Start Date" Variant="Variant.Outlined" Class="mb-3" />
            <MudDatePicker @bind-Date="_endDate" Label="End Date" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_model.BudgetHours" Label="Budget Hours"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_model.BudgetAmount" Label="Budget Amount"
                Variant="Variant.Outlined" Format="N2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || !_valid">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? ProjectId { get; set; }

    private readonly CreateProjectRequest _model = new();
    private ProjectStatus _updateStatus = ProjectStatus.Active;
    private ClientSummaryDto? _client;
    private List<ClientSummaryDto> _allClients = [];
    private DateTime? _startDate, _endDate;
    private MudForm _form = null!;
    private bool _valid, _saving;

    protected override async Task OnInitializedAsync() {
        var cr = await Api.GetAsync<List<ClientSummaryDto>>("/api/clients");
        if (cr.Success && cr.Data is not null) _allClients = cr.Data;

        if (ProjectId.HasValue) {
            var r = await Api.GetAsync<ProjectDto>($"/api/projects/{ProjectId}");
            if (r.Success && r.Data is not null) {
                _model.Name = r.Data.Name;
                _model.Description = r.Data.Description;
                _model.BudgetHours = r.Data.BudgetHours;
                _model.BudgetAmount = r.Data.BudgetAmount;
                _updateStatus = r.Data.Status;
                _startDate = r.Data.StartDate;
                _endDate = r.Data.EndDate;
                _client = _allClients.FirstOrDefault(c => c.Id == r.Data.ClientId);
            }
        }
    }

    private Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? val, CancellationToken ct) {
        var results = string.IsNullOrWhiteSpace(val)
            ? _allClients
            : _allClients.Where(c => c.Name.Contains(val, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ClientSummaryDto>>(results);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid) return;
        _saving = true;
        _model.StartDate = _startDate;
        _model.EndDate = _endDate;

        if (ProjectId.HasValue) {
            var update = new UpdateProjectRequest {
                Name = _model.Name, Description = _model.Description, Status = _updateStatus,
                StartDate = _startDate, EndDate = _endDate,
                BudgetHours = _model.BudgetHours, BudgetAmount = _model.BudgetAmount
            };
            var r = await Api.PutAsync<ProjectDto>($"/api/projects/{ProjectId}", update);
            if (r.Success) { Snackbar.Add("Project updated.", Severity.Success); MudDialog.Close(); }
        } else {
            if (_client is null) { _saving = false; return; }
            _model.ClientId = _client.Id;
            var r = await Api.PostAsync<ProjectDto>("/api/projects", _model);
            if (r.Success) { Snackbar.Add("Project created.", Severity.Success); MudDialog.Close(); }
        }
        _saving = false;
    }
}

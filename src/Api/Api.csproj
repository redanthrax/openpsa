<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContainerRepository>openpsa-api</ContainerRepository>
    <ContainerImageTag>latest</ContainerImageTag>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerPort>8080</ContainerPort>
    <ContainerUser>app</ContainerUser>
    <UserSecretsId>a1b2c3d4-e5f6-7890-abcd-ef1234567890</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ContainerEnvironmentVariable Include="ASPNETCORE_URLS" Value="http://+:8080" />
    <ContainerEnvironmentVariable Include="DOTNET_SYSTEM_GLOBALIZATION_INVARIANT" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="WolverineFX" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Modules\Authentication\Authentication.csproj" />
    <ProjectReference Include="..\Modules\Clients\Clients.csproj" />
    <ProjectReference Include="..\Modules\Contacts\Contacts.csproj" />
    <ProjectReference Include="..\Modules\Tickets\Tickets.csproj" />
    <ProjectReference Include="..\Modules\Projects\Projects.csproj" />
    <ProjectReference Include="..\Modules\TimeEntries\TimeEntries.csproj" />
    <ProjectReference Include="..\Modules\Invoicing\Invoicing.csproj" />
    <ProjectReference Include="..\Modules\Notes\Notes.csproj" />
    <ProjectReference Include="..\Modules\Security\Security.csproj" />
    <ProjectReference Include="..\Modules\Settings\Settings.csproj" />
    <ProjectReference Include="..\Modules\Dashboard\Dashboard.csproj" />
    <ProjectReference Include="..\Modules\Agreements\Agreements.csproj" />
    <ProjectReference Include="..\Modules\Sla\Sla.csproj" />
    <ProjectReference Include="..\Modules\Email\Email.csproj" />
    <ProjectReference Include="..\Modules\Assets\Assets.csproj" />
    <ProjectReference Include="..\Modules\Expenses\Expenses.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

</Project>

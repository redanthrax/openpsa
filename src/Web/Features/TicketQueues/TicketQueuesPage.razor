@page "/settings/ticket-queues"
@layout SettingsLayout
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Ticket Queues — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Ticket Queues</MudText>
</div>

<DataGridPage T="Contracts.Tickets.TicketQueueDto" Items="_queues" Loading="_loading"
    SearchFunc="@((Func<Contracts.Tickets.TicketQueueDto, string>)(x => $"{x.Name} {x.Description}"))">
    <ToolbarContent>
        <HasPermission Permission="ticket-queues.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/settings/ticket-queues/new"))">
                New Queue
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Tickets.TicketQueueDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <PropertyColumn T="Contracts.Tickets.TicketQueueDto" TProperty="string" Property="x => x.Description" Title="Description" />
        <PropertyColumn T="Contracts.Tickets.TicketQueueDto" TProperty="Contracts.Tickets.TicketQueueAssignmentStrategy" Property="x => x.AssignmentStrategy" Title="Assignment">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StrategyColor(context.Item.AssignmentStrategy)">
                    @FormatStrategy(context.Item.AssignmentStrategy)
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Tickets.TicketQueueDto" TProperty="int" Property="x => x.OpenTicketCount" Title="Open Tickets" />
        <PropertyColumn T="Contracts.Tickets.TicketQueueDto" TProperty="bool" Property="x => x.IsActive" Title="Active">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small"
                    Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                    @(context.Item.IsActive ? "Active" : "Inactive")
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Tickets.TicketQueueDto> _queues = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Tickets.TicketQueueDto>("/api/ticket-queues?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _queues = result.Data.ToList();
        _loading = false;
    }


    private static Color StrategyColor(Contracts.Tickets.TicketQueueAssignmentStrategy s) => s switch {
        Contracts.Tickets.TicketQueueAssignmentStrategy.RoundRobin => Color.Info,
        Contracts.Tickets.TicketQueueAssignmentStrategy.LeastBusy => Color.Primary,
        _ => Color.Default
    };

    private static string FormatStrategy(Contracts.Tickets.TicketQueueAssignmentStrategy s) => s switch {
        Contracts.Tickets.TicketQueueAssignmentStrategy.RoundRobin => "Round Robin",
        Contracts.Tickets.TicketQueueAssignmentStrategy.LeastBusy => "Least Busy",
        _ => "Manual"
    };
}

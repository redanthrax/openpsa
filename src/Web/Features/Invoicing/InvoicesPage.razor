@page "/invoices"
@inject IApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Invoices — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Invoices</MudText>
</div>

<DataGridPage T="Contracts.Invoicing.InvoiceSummaryDto" Items="_invoices" Loading="_loading"
    SearchFunc="@((Func<Contracts.Invoicing.InvoiceSummaryDto, string>)(x => $"{x.InvoiceNumber} {x.ClientName} {x.Status}"))"
    RowClick="@(args => Nav.NavigateTo($"/invoices/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="invoices.create">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Timer" OnClick="@(() => Nav.NavigateTo("/invoices/generate"))">
                Generate from Time
            </MudButton>
        </HasPermission>
        <HasPermission Permission="invoices.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/invoices/new"))">
                New Invoice
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Invoicing.InvoiceSummaryDto" TProperty="string" Property="x => x.InvoiceNumber" Title="Number" />
        <PropertyColumn T="Contracts.Invoicing.InvoiceSummaryDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Invoicing.InvoiceSummaryDto" TProperty="Contracts.Invoicing.InvoiceStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Invoicing.InvoiceSummaryDto" TProperty="DateTime" Property="x => x.InvoiceDate" Title="Date" Format="MMM d, yyyy" />
        <PropertyColumn T="Contracts.Invoicing.InvoiceSummaryDto" TProperty="DateTime" Property="x => x.DueDate" Title="Due" Format="MMM d, yyyy" />
        <TemplateColumn T="Contracts.Invoicing.InvoiceSummaryDto" Title="Total" SortBy="x => x.Total">
            <CellTemplate><MudText>@context.Item.Total.ToString("C2")</MudText></CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Contracts.Invoicing.InvoiceSummaryDto" Title="Balance Due" SortBy="x => x.AmountDue">
            <CellTemplate>
                <MudText Color="@(context.Item.AmountDue > 0 ? Color.Error : Color.Default)">
                    @context.Item.AmountDue.ToString("C2")
                </MudText>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Invoicing.InvoiceSummaryDto> _invoices = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Invoicing.InvoiceSummaryDto>("/api/invoices?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _invoices = result.Data.ToList();
        _loading = false;
    }


    private static Color StatusColor(Contracts.Invoicing.InvoiceStatus s) => s switch {
        Contracts.Invoicing.InvoiceStatus.Paid => Color.Success,
        Contracts.Invoicing.InvoiceStatus.Sent or Contracts.Invoicing.InvoiceStatus.Viewed => Color.Info,
        Contracts.Invoicing.InvoiceStatus.Overdue => Color.Error,
        Contracts.Invoicing.InvoiceStatus.PartiallyPaid => Color.Warning,
        Contracts.Invoicing.InvoiceStatus.Void => Color.Default,
        _ => Color.Default
    };
}

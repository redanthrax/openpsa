@using OpenPsa.Web.Services
@using OpenPsa.Web.Themes
@using Microsoft.JSInterop
@inject ThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <BaseLayout>
                        <RedirectToLogin />
                    </BaseLayout>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <BaseLayout>
                <MudText Typo="Typo.h5" Class="mt-8 text-center">Page not found.</MudText>
            </BaseLayout>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private const string ThemePreferenceKey = "openpsa-theme";
    private const string PresetPreferenceKey = "openpsa-preset";
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;
    private MudTheme _theme = ThemeRegistry.GetTheme(ThemePreset.Professional);

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;

        var savedDark = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ThemePreferenceKey);
        _isDarkMode = !string.IsNullOrEmpty(savedDark) && bool.TryParse(savedDark, out var v)
            ? v
            : await _mudThemeProvider.GetSystemDarkModeAsync();

        var savedPreset = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", PresetPreferenceKey);
        var preset = Enum.TryParse<ThemePreset>(savedPreset, out var p) ? p : ThemePreset.Professional;
        _theme = ThemeRegistry.GetTheme(preset);

        ThemeService.Initialize(_isDarkMode, preset);
        ThemeService.OnThemeChanged += HandleThemeChanged;
        StateHasChanged();
    }

    private async void HandleThemeChanged() {
        _isDarkMode = ThemeService.IsDarkMode;
        _theme = ThemeRegistry.GetTheme(ThemeService.Preset);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", ThemePreferenceKey, _isDarkMode.ToString());
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", PresetPreferenceKey, ThemeService.Preset.ToString());
        StateHasChanged();
    }

    public void Dispose() => ThemeService.OnThemeChanged -= HandleThemeChanged;
}

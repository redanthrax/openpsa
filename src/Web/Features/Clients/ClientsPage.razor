@page "/clients"
@inject IApiClient Api
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<PageTitle>Clients — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Clients</MudText>
    <HasPermission Permission="clients.create">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="OpenCreateDialog">New Client</MudButton>
    </HasPermission>
</div>

<MudCard>
    <MudCardContent Class="pa-0">
        <MudDataGrid T="Contracts.Clients.ClientSummaryDto" Items="_clients" Loading="_loading"
            Filterable="true" FilterMode="DataGridFilterMode.Simple" SortMode="SortMode.Multiple"
            Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.Status" Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                            Color="@(context.Item.Status == Contracts.Clients.ClientStatus.Active ? Color.Success : Color.Default)">
                            @context.Item.Status
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.ActiveProjects" Title="Active Projects" />
                <PropertyColumn Property="x => x.OpenTickets" Title="Open Tickets" />
                <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                            Href="@($"/clients/{context.Item.Id}")" />
                        <HasPermission Permission="clients.update">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                OnClick="@(() => OpenEditDialog(context.Item.Id))" />
                        </HasPermission>
                        <HasPermission Permission="clients.delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                OnClick="@(() => DeleteAsync(context.Item.Id, context.Item.Name))" />
                        </HasPermission>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private List<Contracts.Clients.ClientSummaryDto> _clients = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetAsync<List<Contracts.Clients.ClientSummaryDto>>("/api/clients");
        if (result.Success && result.Data is not null) _clients = result.Data;
        _loading = false;
    }

    private async Task OpenCreateDialog() {
        var dialog = await Dialog.ShowAsync<ClientDialog>("New Client");
        if (!(await dialog.Result).Canceled) await LoadAsync();
    }

    private async Task OpenEditDialog(Guid id) {
        var param = new DialogParameters<ClientDialog> { { x => x.ClientId, id } };
        var dialog = await Dialog.ShowAsync<ClientDialog>("Edit Client", param);
        if (!(await dialog.Result).Canceled) await LoadAsync();
    }

    private async Task DeleteAsync(Guid id, string name) {
        var ok = await Dialog.ShowMessageBox("Delete Client",
            $"Delete \"{name}\"? This cannot be undone.", "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var result = await Api.DeleteAsync<object>($"/api/clients/{id}");
        if (result.Success) { Snackbar.Add("Client deleted.", Severity.Success); await LoadAsync(); }
    }
}

@page "/clients/{ClientId:guid}/sites/new"
@layout Layout.ClientLayout
@using Contracts.Sites
@inject IApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>New Site — OpenPsa</PageTitle>

<FormPage Title="New Site" BackUrl="@($"/clients/{ClientId}")" Saving="_saving" Valid="_valid" OnSave="SaveAsync">
    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudTextField @bind-Value="_name" Label="Site Name" Required="true"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_address" Label="Address"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="5">
                <MudTextField @bind-Value="_city" Label="City" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="3">
                <MudTextField @bind-Value="_state" Label="State" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="_postalCode" Label="Postal Code" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6">
                <MudTextField @bind-Value="_country" Label="Country" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_timezone" Label="Timezone" Variant="Variant.Outlined"
                    HelperText="e.g. America/New_York" />
            </MudItem>
        </MudGrid>
        <MudTextField @bind-Value="_phone" Label="Phone"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_notes" Label="Notes" Lines="2"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudSwitch @bind-Value="_isPrimary" Label="Primary Site" Color="Color.Primary" />
    </MudForm>
</FormPage>

@code {
    [Parameter] public Guid ClientId { get; set; }

    private string _name = string.Empty;
    private string? _address, _city, _state, _postalCode, _country, _timezone, _phone, _notes;
    private bool _isPrimary;
    private MudForm _form = null!;
    private bool _valid, _saving;

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid) return;
        _saving = true;
        var create = new CreateSiteRequest {
            ClientId = ClientId, Name = _name, Address = _address, City = _city, State = _state,
            PostalCode = _postalCode, Country = _country, Timezone = _timezone,
            Phone = _phone, Notes = _notes, IsPrimary = _isPrimary
        };
        var r = await Api.PostAsync<SiteDto>("/api/sites", create);
        if (r.Success) {
            Snackbar.Add("Site created.", Severity.Success);
            Nav.NavigateTo($"/clients/{ClientId}");
        }
        _saving = false;
    }
}

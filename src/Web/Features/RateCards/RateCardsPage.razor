@page "/settings/rate-cards"
@layout SettingsLayout
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Rate Cards — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Rate Cards</MudText>
</div>

<DataGridPage T="Contracts.TimeEntries.RateCardDto" Items="_rateCards" Loading="_loading"
    SearchFunc="@((Func<Contracts.TimeEntries.RateCardDto, string>)(x => $"{x.Name} {x.ClientName ?? "Global"}"))">
    <ToolbarContent>
        <HasPermission Permission="rate-cards.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/settings/rate-cards/new"))">
                New Rate Card
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.TimeEntries.RateCardDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <TemplateColumn T="Contracts.TimeEntries.RateCardDto" Title="Client" SortBy="x => x.ClientName">
            <CellTemplate>
                <MudText>@(context.Item.ClientName ?? "Global")</MudText>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn T="Contracts.TimeEntries.RateCardDto" TProperty="bool" Property="x => x.IsDefault" Title="Default">
            <CellTemplate>
                @if (context.Item.IsDefault) {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Default</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.TimeEntries.RateCardDto" TProperty="int" Property="x => x.Entries.Count" Title="Rates" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.TimeEntries.RateCardDto> _rateCards = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.TimeEntries.RateCardDto>("/api/rate-cards?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _rateCards = result.Data.ToList();
        _loading = false;
    }

}

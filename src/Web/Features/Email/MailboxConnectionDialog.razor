@using Contracts.Email
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>@(ConnectionId.HasValue ? "Edit Mailbox Connection" : "New Mailbox Connection")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudTextField @bind-Value="_name" Label="Display Name" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_emailAddress" Label="Email Address" Required="true"
                Variant="Variant.Outlined" Class="mb-3" InputType="InputType.Email" />
            <MudSelect @bind-Value="_provider" Label="Provider" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="MailboxProvider.Imap">IMAP / SMTP</MudSelectItem>
                <MudSelectItem Value="MailboxProvider.MicrosoftGraph">Microsoft 365 (Graph API)</MudSelectItem>
            </MudSelect>

            @if (_provider == MailboxProvider.Imap) {
                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">IMAP Settings</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="8">
                        <MudTextField @bind-Value="_imapHost" Label="IMAP Host"
                            Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField @bind-Value="_imapPort" Label="Port"
                            Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                <MudSwitch @bind-Value="_imapUseSsl" Label="Use SSL/TLS" Color="Color.Primary" Class="mb-3" />
                <MudTextField @bind-Value="_imapUsername" Label="IMAP Username"
                    Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_imapPassword" Label="IMAP Password"
                    Variant="Variant.Outlined" Class="mb-3" InputType="InputType.Password"
                    Placeholder="@(ConnectionId.HasValue ? "(unchanged)" : "")" />

                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">SMTP Settings</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="8">
                        <MudTextField @bind-Value="_smtpHost" Label="SMTP Host"
                            Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField @bind-Value="_smtpPort" Label="Port"
                            Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                <MudSwitch @bind-Value="_smtpUseSsl" Label="Use SSL/TLS" Color="Color.Primary" Class="mb-3" />
                <MudTextField @bind-Value="_smtpUsername" Label="SMTP Username"
                    Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_smtpPassword" Label="SMTP Password"
                    Variant="Variant.Outlined" Class="mb-3" InputType="InputType.Password"
                    Placeholder="@(ConnectionId.HasValue ? "(unchanged)" : "")" />
            }

            @if (_provider == MailboxProvider.MicrosoftGraph) {
                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Microsoft Graph Settings</MudText>
                <MudTextField @bind-Value="_graphTenantId" Label="Tenant ID"
                    Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_graphClientId" Label="Client ID"
                    Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_graphClientSecret" Label="Client Secret"
                    Variant="Variant.Outlined" Class="mb-3" InputType="InputType.Password"
                    Placeholder="@(ConnectionId.HasValue ? "(unchanged)" : "")" />
                <MudTextField @bind-Value="_graphMailboxUserId" Label="Mailbox User ID or UPN"
                    Variant="Variant.Outlined" Class="mb-3"
                    HelperText="The user principal name or object ID of the shared mailbox" />
            }

            <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">Options</MudText>
            <MudNumericField @bind-Value="_pollIntervalSeconds" Label="Poll Interval (seconds)"
                Variant="Variant.Outlined" Class="mb-3" Min="15" />
            <MudSwitch @bind-Value="_autoCreateContacts" Label="Auto-create contacts for unknown senders"
                Color="Color.Primary" Class="mb-3" />

            @if (ConnectionId.HasValue) {
                <MudSelect @bind-Value="_status" Label="Status" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var s in Enum.GetValues<MailboxConnectionStatus>()) {
                        <MudSelectItem Value="s">@s</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || !_valid">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? ConnectionId { get; set; }

    private string _name = string.Empty;
    private string _emailAddress = string.Empty;
    private MailboxProvider _provider = MailboxProvider.Imap;
    private MailboxConnectionStatus _status = MailboxConnectionStatus.Active;
    private string? _imapHost;
    private int? _imapPort = 993;
    private bool _imapUseSsl = true;
    private string? _imapUsername;
    private string? _imapPassword;
    private string? _smtpHost;
    private int? _smtpPort = 587;
    private bool _smtpUseSsl = true;
    private string? _smtpUsername;
    private string? _smtpPassword;
    private string? _graphTenantId;
    private string? _graphClientId;
    private string? _graphClientSecret;
    private string? _graphMailboxUserId;
    private int _pollIntervalSeconds = 60;
    private bool _autoCreateContacts = true;
    private MudForm _form = null!;
    private bool _valid, _saving;

    protected override async Task OnInitializedAsync() {
        if (ConnectionId.HasValue) {
            var r = await Api.GetAsync<MailboxConnectionDto>($"/api/mailbox-connections/{ConnectionId.Value}");
            if (r.Success && r.Data is not null) {
                var c = r.Data;
                _name = c.Name;
                _emailAddress = c.EmailAddress;
                _provider = c.Provider;
                _status = c.Status;
                _imapHost = c.ImapHost;
                _imapPort = c.ImapPort;
                _imapUseSsl = c.ImapUseSsl;
                _smtpHost = c.SmtpHost;
                _smtpPort = c.SmtpPort;
                _smtpUseSsl = c.SmtpUseSsl;
                _graphTenantId = c.GraphTenantId;
                _graphClientId = c.GraphClientId;
                _graphMailboxUserId = c.GraphMailboxUserId;
                _pollIntervalSeconds = c.PollIntervalSeconds;
                _autoCreateContacts = c.AutoCreateContacts;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid) return;
        _saving = true;

        if (ConnectionId.HasValue) {
            var update = new UpdateMailboxConnectionRequest {
                Name = _name, EmailAddress = _emailAddress, Status = _status,
                ImapHost = _imapHost, ImapPort = _imapPort, ImapUseSsl = _imapUseSsl,
                ImapUsername = _imapUsername, ImapPassword = _imapPassword,
                SmtpHost = _smtpHost, SmtpPort = _smtpPort, SmtpUseSsl = _smtpUseSsl,
                SmtpUsername = _smtpUsername, SmtpPassword = _smtpPassword,
                GraphTenantId = _graphTenantId, GraphClientId = _graphClientId,
                GraphClientSecret = _graphClientSecret, GraphMailboxUserId = _graphMailboxUserId,
                PollIntervalSeconds = _pollIntervalSeconds, AutoCreateContacts = _autoCreateContacts
            };
            var r = await Api.PutAsync<MailboxConnectionDto>($"/api/mailbox-connections/{ConnectionId.Value}", update);
            if (r.Success) { Snackbar.Add("Connection updated.", Severity.Success); MudDialog.Close(); }
        } else {
            var create = new CreateMailboxConnectionRequest {
                Name = _name, EmailAddress = _emailAddress, Provider = _provider,
                ImapHost = _imapHost, ImapPort = _imapPort, ImapUseSsl = _imapUseSsl,
                ImapUsername = _imapUsername, ImapPassword = _imapPassword,
                SmtpHost = _smtpHost, SmtpPort = _smtpPort, SmtpUseSsl = _smtpUseSsl,
                SmtpUsername = _smtpUsername, SmtpPassword = _smtpPassword,
                GraphTenantId = _graphTenantId, GraphClientId = _graphClientId,
                GraphClientSecret = _graphClientSecret, GraphMailboxUserId = _graphMailboxUserId,
                PollIntervalSeconds = _pollIntervalSeconds, AutoCreateContacts = _autoCreateContacts
            };
            var r = await Api.PostAsync<MailboxConnectionDto>("/api/mailbox-connections", create);
            if (r.Success) { Snackbar.Add("Connection created.", Severity.Success); MudDialog.Close(); }
        }
        _saving = false;
    }
}

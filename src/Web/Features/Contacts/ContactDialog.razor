@using Contracts.Contacts
@using Contracts.Clients
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>@(Contact is not null ? "Edit Contact" : "New Contact")</TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudAutocomplete T="ClientSummaryDto" Label="Client" Required="true"
                @bind-Value="_client" SearchFunc="SearchClientsAsync"
                ToStringFunc="@(c => c?.Name ?? string.Empty)"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.FirstName" Label="First Name" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.LastName" Label="Last Name" Required="true"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.Title" Label="Title"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.Email" Label="Email" InputType="InputType.Email"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_model.Phone" Label="Phone"
                Variant="Variant.Outlined" Class="mb-3" />
            <MudCheckBox @bind-Value="_model.IsPrimary" Label="Primary Contact" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || !_valid">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ContactDto? Contact { get; set; }

    private readonly CreateContactRequest _model = new();
    private ClientSummaryDto? _client;
    private List<ClientSummaryDto> _allClients = [];
    private MudForm _form = null!;
    private bool _valid, _saving;

    protected override async Task OnInitializedAsync() {
        var r = await Api.GetAsync<List<ClientSummaryDto>>("/api/clients");
        if (r.Success && r.Data is not null) _allClients = r.Data;

        if (Contact is not null) {
            _model.FirstName = Contact.FirstName;
            _model.LastName = Contact.LastName;
            _model.Title = Contact.Title;
            _model.Email = Contact.Email;
            _model.Phone = Contact.Phone;
            _model.IsPrimary = Contact.IsPrimary;
            _model.ClientId = Contact.ClientId;
            _client = _allClients.FirstOrDefault(c => c.Id == Contact.ClientId);
        }
    }

    private Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? val, CancellationToken ct) {
        var results = string.IsNullOrWhiteSpace(val)
            ? _allClients
            : _allClients.Where(c => c.Name.Contains(val, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ClientSummaryDto>>(results);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid || _client is null) return;
        _model.ClientId = _client.Id;
        _saving = true;
        if (Contact is not null) {
            var update = new Contracts.Contacts.UpdateContactRequest {
                FirstName = _model.FirstName, LastName = _model.LastName, Title = _model.Title,
                Email = _model.Email, Phone = _model.Phone, IsPrimary = _model.IsPrimary
            };
            var r = await Api.PutAsync<ContactDto>($"/api/contacts/{Contact.Id}", update);
            if (r.Success) { Snackbar.Add("Contact updated.", Severity.Success); MudDialog.Close(); }
        } else {
            var r = await Api.PostAsync<ContactDto>("/api/contacts", _model);
            if (r.Success) { Snackbar.Add("Contact created.", Severity.Success); MudDialog.Close(); }
        }
        _saving = false;
    }
}

<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><style>
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #333; margin: 0; padding: 0; }
.container { max-width: 600px; margin: 0 auto; padding: 20px; }
.header { background: #1565c0; color: #fff; padding: 16px 20px; border-radius: 6px 6px 0 0; }
.header h2 { margin: 0; font-size: 18px; }
.body { background: #f9f9f9; padding: 20px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 6px 6px; }
.meta { color: #666; font-size: 13px; margin-bottom: 12px; }
.meta strong { color: #333; }
.content { background: #fff; padding: 16px; border-radius: 4px; border: 1px solid #e8e8e8; margin-top: 12px; }
.footer { text-align: center; color: #999; font-size: 11px; margin-top: 20px; }
.btn { display: inline-block; background: #1565c0; color: #fff; padding: 10px 20px; text-decoration: none; border-radius: 4px; margin-top: 16px; }
</style></head>
<body>
<div class="container">
  <div class="header"><h2>Ticket Created: #{{ ticket_number }}</h2></div>
  <div class="body">
    <p>A new ticket has been created{{ if client_name }} for <strong>{{ client_name }}</strong>{{ end }}.</p>
    <div class="meta">
      <p><strong>Subject:</strong> {{ ticket_subject }}</p>
      <p><strong>Priority:</strong> {{ priority }}</p>
      <p><strong>Type:</strong> {{ ticket_type }}</p>
      {{ if assigned_to }}<p><strong>Assigned to:</strong> {{ assigned_to }}</p>{{ end }}
      {{ if queue_name }}<p><strong>Queue:</strong> {{ queue_name }}</p>{{ end }}
    </div>
    {{ if description }}
    <div class="content">{{ description }}</div>
    {{ end }}
    {{ if portal_url }}
    <a href="{{ portal_url }}" class="btn">View Ticket</a>
    {{ end }}
  </div>
  <div class="footer">{{ company_name }}</div>
</div>
</body>
</html>

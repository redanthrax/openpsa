@page "/assets"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Assets — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Assets</MudText>
</div>

<DataGridPage T="Contracts.Assets.AssetSummaryDto" Items="_assets" Loading="_loading"
    SearchFunc="@((Func<Contracts.Assets.AssetSummaryDto, string>)(x => $"{x.Name} {x.ClientName} {x.Type} {x.Status} {x.SerialNumber}"))"
    RowClick="@(args => Nav.NavigateTo($"/assets/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="assets.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/assets/new"))">
                New Asset
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="Contracts.Assets.AssetType" Property="x => x.Type" Title="Type">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@TypeColor(context.Item.Type)">
                    @FormatType(context.Item.Type)
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="Contracts.Assets.AssetStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="string" Property="x => x.Manufacturer" Title="Manufacturer" />
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="string" Property="x => x.Model" Title="Model" />
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="string" Property="x => x.SerialNumber" Title="Serial #" />
        <PropertyColumn T="Contracts.Assets.AssetSummaryDto" TProperty="DateTime?" Property="x => x.WarrantyExpiry" Title="Warranty" Format="MMM d, yyyy">
            <CellTemplate>
                @if (context.Item.WarrantyExpiry.HasValue) {
                    var expired = context.Item.WarrantyExpiry.Value < DateTime.Today;
                    <MudText Color="@(expired ? Color.Error : Color.Default)">
                        @context.Item.WarrantyExpiry.Value.ToString("MMM d, yyyy")
                    </MudText>
                }
            </CellTemplate>
        </PropertyColumn>
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Assets.AssetSummaryDto> _assets = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Assets.AssetSummaryDto>("/api/assets?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _assets = result.Data.ToList();
        _loading = false;
    }


    private static Color TypeColor(Contracts.Assets.AssetType t) => t switch {
        Contracts.Assets.AssetType.Server => Color.Error,
        Contracts.Assets.AssetType.NetworkDevice => Color.Info,
        Contracts.Assets.AssetType.Workstation or Contracts.Assets.AssetType.Laptop => Color.Primary,
        Contracts.Assets.AssetType.SoftwareLicense => Color.Warning,
        _ => Color.Default
    };

    private static string FormatType(Contracts.Assets.AssetType t) => t switch {
        Contracts.Assets.AssetType.NetworkDevice => "Network",
        Contracts.Assets.AssetType.SoftwareLicense => "Software",
        Contracts.Assets.AssetType.MobileDevice => "Mobile",
        _ => t.ToString()
    };

    private static Color StatusColor(Contracts.Assets.AssetStatus s) => s switch {
        Contracts.Assets.AssetStatus.Deployed => Color.Success,
        Contracts.Assets.AssetStatus.InRepair => Color.Warning,
        Contracts.Assets.AssetStatus.Retired or Contracts.Assets.AssetStatus.Disposed => Color.Default,
        _ => Color.Info
    };
}

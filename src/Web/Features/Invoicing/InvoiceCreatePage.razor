@page "/invoices/new"
@using Contracts.Invoicing
@using Contracts.Clients
@inject IApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>New Invoice — OpenPsa</PageTitle>

<FormPage Title="New Invoice" BackUrl="/invoices" Saving="_saving" Valid="@(_valid && _lineItems.Count > 0)"
    OnSave="SaveAsync" SaveLabel="Create Invoice" Loading="_loading">
    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudAutocomplete T="ClientSummaryDto" Label="Client" Required="true"
            @bind-Value="_client" SearchFunc="SearchClientsAsync"
            ToStringFunc="@(c => c?.Name ?? string.Empty)"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudDatePicker @bind-Date="_invoiceDate" Label="Invoice Date" Required="true"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudDatePicker @bind-Date="_dueDate" Label="Due Date" Required="true"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_notes" Label="Notes" Lines="2"
            Variant="Variant.Outlined" Class="mb-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Line Items</MudText>
        @foreach (var (item, i) in _lineItems.Select((x, i) => (x, i))) {
            <MudGrid Class="mb-2" Spacing="1">
                <MudItem xs="5">
                    <MudTextField @bind-Value="item.Description" Label="Description"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="2">
                    <MudNumericField @bind-Value="item.Quantity" Label="Qty"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="N2" />
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="item.UnitPrice" Label="Unit Price"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="N2" />
                </MudItem>
                <MudItem xs="2" Class="d-flex align-center">
                    <MudText Class="mr-2">@((item.Quantity * item.UnitPrice).ToString("C2"))</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                        Color="Color.Error" OnClick="@(() => _lineItems.RemoveAt(i))" />
                </MudItem>
            </MudGrid>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text"
            OnClick="AddItem" Class="mt-1">Add Line Item</MudButton>
    </MudForm>
</FormPage>

@code {
    private ClientSummaryDto? _client;
    private List<ClientSummaryDto> _allClients = [];
    private List<CreateInvoiceLineItemRequest> _lineItems = [];
    private DateTime? _invoiceDate = DateTime.Today;
    private DateTime? _dueDate = DateTime.Today.AddDays(30);
    private string? _notes;
    private MudForm _form = null!;
    private bool _valid, _saving, _loading = true;

    protected override async Task OnInitializedAsync() {
        var r = await Api.GetAsync<List<ClientSummaryDto>>("/api/clients");
        if (r.Success && r.Data is not null) _allClients = r.Data;
        AddItem();
        _loading = false;
    }

    private void AddItem() => _lineItems.Add(new CreateInvoiceLineItemRequest { Quantity = 1 });

    private Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? val, CancellationToken ct) {
        var res = string.IsNullOrWhiteSpace(val) ? _allClients
            : _allClients.Where(c => c.Name.Contains(val, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ClientSummaryDto>>(res);
    }

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid || _client is null || _invoiceDate is null || _dueDate is null) return;
        _saving = true;
        var req = new CreateInvoiceRequest {
            ClientId = _client.Id, InvoiceDate = _invoiceDate.Value,
            DueDate = _dueDate.Value, Notes = _notes, LineItems = _lineItems
        };
        var r = await Api.PostAsync<InvoiceDto>("/api/invoices", req);
        if (r.Success) {
            Snackbar.Add("Invoice created.", Severity.Success);
            Nav.NavigateTo($"/invoices/{r.Data!.Id}");
        }
        _saving = false;
    }
}

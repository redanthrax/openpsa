@page "/projects"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>Projects — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Projects</MudText>
</div>

<DataGridPage T="Contracts.Projects.ProjectSummaryDto" Items="_projects" Loading="_loading"
    SearchFunc="@((Func<Contracts.Projects.ProjectSummaryDto, string>)(x => $"{x.Name} {x.ClientName} {x.Status}"))"
    RowClick="@(args => Nav.NavigateTo($"/projects/{args.Item.Id}"))">
    <ToolbarContent>
        <HasPermission Permission="projects.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/projects/new"))">
                New Project
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Projects.ProjectSummaryDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <PropertyColumn T="Contracts.Projects.ProjectSummaryDto" TProperty="string" Property="x => x.ClientName" Title="Client" />
        <PropertyColumn T="Contracts.Projects.ProjectSummaryDto" TProperty="Contracts.Projects.ProjectStatus" Property="x => x.Status" Title="Status">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn T="Contracts.Projects.ProjectSummaryDto" Title="Hours" SortBy="x => x.LoggedHours">
            <CellTemplate>
                @if (context.Item.BudgetHours.HasValue) {
                    <MudText>@context.Item.LoggedHours / @context.Item.BudgetHours h</MudText>
                } else {
                    <MudText>@context.Item.LoggedHours h</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn T="Contracts.Projects.ProjectSummaryDto" TProperty="DateTime?" Property="x => x.EndDate" Title="Due" Format="MMM d, yyyy" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Projects.ProjectSummaryDto> _projects = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Projects.ProjectSummaryDto>("/api/projects?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _projects = result.Data.ToList();
        _loading = false;
    }


    private static Color StatusColor(Contracts.Projects.ProjectStatus s) => s switch {
        Contracts.Projects.ProjectStatus.Active => Color.Success,
        Contracts.Projects.ProjectStatus.Completed => Color.Info,
        Contracts.Projects.ProjectStatus.OnHold => Color.Warning,
        _ => Color.Default
    };
}

@page "/settings/sla-policies"
@layout SettingsLayout
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>SLA Policies — OpenPsa</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">SLA Policies</MudText>
</div>

<DataGridPage T="Contracts.Sla.SlaPolicySummaryDto" Items="_policies" Loading="_loading"
    SearchFunc="@((Func<Contracts.Sla.SlaPolicySummaryDto, string>)(x => x.Name))">
    <ToolbarContent>
        <HasPermission Permission="sla-policies.create">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/settings/sla-policies/new"))">
                New Policy
            </MudButton>
        </HasPermission>
    </ToolbarContent>
    <Columns>
        <PropertyColumn T="Contracts.Sla.SlaPolicySummaryDto" TProperty="string" Property="x => x.Name" Title="Name" />
        <PropertyColumn T="Contracts.Sla.SlaPolicySummaryDto" TProperty="bool" Property="x => x.IsDefault" Title="Default">
            <CellTemplate>
                @if (context.Item.IsDefault) {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Default</MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="Contracts.Sla.SlaPolicySummaryDto" TProperty="int" Property="x => x.TargetCount" Title="Targets" />
    </Columns>
</DataGridPage>

@code {
    private List<Contracts.Sla.SlaPolicySummaryDto> _policies = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() {
        _loading = true;
        var result = await Api.GetPagedAsync<Contracts.Sla.SlaPolicySummaryDto>("/api/sla-policies?page=1&pageSize=1000");
        if (result.Success && result.Data is not null) _policies = result.Data.ToList();
        _loading = false;
    }

}

@page "/contacts/new"
@page "/clients/{ClientId:guid}/contacts/new"
@using Contracts.Contacts
@using Contracts.Clients
@inject IApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>New Contact — OpenPsa</PageTitle>

<FormPage Title="New Contact" BackUrl="@BackUrl" Saving="_saving" Valid="_valid" OnSave="SaveAsync" Loading="_loading">
    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudAutocomplete T="ClientSummaryDto" Label="Client" Required="true"
            @bind-Value="_client" SearchFunc="SearchClientsAsync"
            ToStringFunc="@(c => c?.Name ?? string.Empty)"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.FirstName" Label="First Name" Required="true"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.LastName" Label="Last Name" Required="true"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.Title" Label="Title"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.Email" Label="Email" InputType="InputType.Email"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.Phone" Label="Phone"
            Variant="Variant.Outlined" Class="mb-3" />
        <MudCheckBox @bind-Value="_model.IsPrimary" Label="Primary Contact" />
    </MudForm>
</FormPage>

@code {
    [Parameter] public Guid? ClientId { get; set; }

    private readonly CreateContactRequest _model = new();
    private ClientSummaryDto? _client;
    private List<ClientSummaryDto> _allClients = [];
    private MudForm _form = null!;
    private bool _valid, _saving, _loading = true;

    private string BackUrl => ClientId.HasValue ? $"/clients/{ClientId}/contacts" : "/contacts";

    protected override async Task OnInitializedAsync() {
        var r = await Api.GetAsync<List<ClientSummaryDto>>("/api/clients");
        if (r.Success && r.Data is not null) {
            _allClients = r.Data;
            if (ClientId.HasValue)
                _client = _allClients.FirstOrDefault(c => c.Id == ClientId.Value);
        }
        _loading = false;
    }

    private Task<IEnumerable<ClientSummaryDto>> SearchClientsAsync(string? val, CancellationToken ct) {
        var results = string.IsNullOrWhiteSpace(val) ? _allClients
            : _allClients.Where(c => c.Name.Contains(val, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult<IEnumerable<ClientSummaryDto>>(results);
    }

    private async Task SaveAsync() {
        await _form.Validate();
        if (!_valid || _client is null) return;
        _model.ClientId = _client.Id;
        _saving = true;
        var r = await Api.PostAsync<ContactDto>("/api/contacts", _model);
        if (r.Success) {
            Snackbar.Add("Contact created.", Severity.Success);
            Nav.NavigateTo(ClientId.HasValue ? $"/clients/{ClientId}/contacts" : $"/contacts/{r.Data!.Id}");
        }
        _saving = false;
    }
}
